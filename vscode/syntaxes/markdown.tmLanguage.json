{
  "scopeName": "spl2.markdown.injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#spl2-fenced-code-block"
    },
    {
      "begin": "^ {0,3}>\\s?",
      "end": "$",
      "name": "markup.quote.spl2",
      "contentName": "string.unquoted.blockquote.spl2",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.quote.begin.spl2" }
      },
      "patterns": [
        {
          "match": "(?<![\\w@])@[A-Za-z_]\\w*",
          "name": "meta.embedded.inline.spl2 variable.other.reference.spl2"
        }
      ]
    }
  ],
  "repository": {
    "spl2-fenced-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(spl2)(?:\\s+[^`~]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.spl2",
          "patterns": [
            { "include": "source.spl2" }
          ]
        }
      ]
    }
  }
}
